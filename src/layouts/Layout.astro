---
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/global.css';
import { asset, home, sourcesPath, tuningPath } from '../lib/paths';

interface Props {
  /** The page's own name; "Primer" is added after it in the browser tab. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Primer` : 'Primer: XIM MATRIX settings, explained';
const isHome = Astro.url.pathname === home();
const current = (path: string) => (Astro.url.pathname === path ? 'page' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111316" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('manifest.webmanifest')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="masthead">
      {
        isHome ? (
          <span class="wordmark" aria-hidden="true">
            Primer
          </span>
        ) : (
          <a class="wordmark" href={home()}>
            Primer<span class="visually-hidden">: the map of settings</span>
          </a>
        )
      }
      <nav aria-label="Primer">
        <a href={tuningPath()} aria-current={current(tuningPath())}>Tuning</a>
        <a href={sourcesPath()} aria-current={current(sourcesPath())}>How to read it</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="colophon">
      <p>
        Primer is an independent guide. It is not made by or affiliated with XIM Technologies. Every sentence is checked
        against the source it cites; where no source says something, Primer says so.
      </p>
      <p><a href={sourcesPath()}>Sources and confidence labels</a></p>
    </footer>
    <script>
      // Offline reading: the service worker keeps every page of the guide on the phone.
      // (Also on this computer, to test a production build with `npm run preview`.)
      const secure = location.protocol === 'https:' || ['localhost', '127.0.0.1'].includes(location.hostname);
      if ('serviceWorker' in navigator && secure) {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}sw.js`).catch(() => {});
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -4rem;
    z-index: 10;
    padding: 0.5rem 0.8rem;
    background: var(--ink);
    color: var(--paper);
    font: 600 0.95rem/1 var(--f-label);
  }

  .skip:focus {
    top: calc(env(safe-area-inset-top, 0px) + 0.5rem);
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: calc(env(safe-area-inset-top, 0px) + 0.9rem) var(--gutter) 0.6rem;
    border-bottom: 1.5px solid var(--rule-strong);
  }

  .wordmark {
    font: 700 1.35rem/1 var(--f-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem 1.1rem;
  }

  nav a {
    font: 600 0.95rem/1 var(--f-label);
    letter-spacing: 0.04em;
  }

  nav a[aria-current='page'] {
    color: var(--ink-3);
    text-decoration-color: var(--ink-3);
  }

  main {
    display: block;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 1.4rem var(--gutter) 2.5rem;
  }

  main:focus {
    outline: none;
  }

  .colophon {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 1.2rem var(--gutter) calc(env(safe-area-inset-bottom, 0px) + 2rem);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 0.5rem;
    color: var(--ink-3);
    font-size: 0.88rem;
  }
</style>
